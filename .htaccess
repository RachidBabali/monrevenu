RewriteEngine On

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^produit/([a-z0-9\-]+)/([A-Za-z0-9_\-]+)/?$ produit.php?slug=$1&token=$2 [L,QSA]

# ====================================================
# En-têtes de sécurité – MonRevenu
# ====================================================
<IfModule mod_headers.c>
    # Protection anti-clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # CSP autorisant cdn.monrevenu.xyz (images) et Cloudflare Insights (scripts)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://accounts.google.com https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; font-src 'self'; img-src 'self' data: https://cdn.monrevenu.xyz; connect-src 'self' https://cloudflareinsights.com https://accounts.google.com; frame-src https://accounts.google.com; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
    # Protection MIME sniffing
    Header always set X-Content-Type-Options "nosniff"

    # N'envoie l'URL complete du referrer qu'aux origines identiques ; une origine seule (sans
    # chemin ni jeton) pour un lien externe (I5, signale par la page Sante).
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Desactive les API navigateur non utilisees par le site (aucun appareil photo, micro,
    # geolocalisation ni paiement demande cote client).
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # Masquage signature PHP
    Header unset X-Powered-By
</IfModule>

# Fichiers internes jamais servis (schemas, notes, dependances, outils locaux)
<FilesMatch "(\.(sql|md|lock)|^composer\.json|^\.env.*)$">
    Require all denied
</FilesMatch>
RedirectMatch 404 ^/(dev|\.kilo|migrations|storage|tools)(/|$)
