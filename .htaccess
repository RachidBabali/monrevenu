RewriteEngine On

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^produit/([a-z0-9\-]+)/([A-Za-z0-9_\-]+)/?$ produit.php?slug=$1&token=$2 [L,QSA]

# ====================================================
# En-têtes de sécurité – MonRevenu
# ====================================================
<IfModule mod_headers.c>
    # Protection anti-clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # CSP en liste blanche stricte : on part de default-src 'none' (tout est refuse
    # par defaut) puis on autorise explicitement chaque type de ressource utilise.
    # worker-src et manifest-src sont indispensables (service worker des notifications
    # push + manifest PWA) : sans eux, default-src 'none' les bloquerait.
    # style-src conserve 'unsafe-inline' pour l'instant (page d'erreur 500 auto-suffisante
    # + styles injectes par Google Sign-In) : retrait a valider en environnement de test.
    Header always set Content-Security-Policy "default-src 'none'; script-src 'self' https://static.cloudflareinsights.com https://accounts.google.com; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: https://cdn.monrevenu.xyz; font-src 'self'; connect-src 'self' https://cloudflareinsights.com https://accounts.google.com; frame-src https://accounts.google.com; manifest-src 'self'; worker-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'self'; object-src 'none'"
    # Protection MIME sniffing
    Header always set X-Content-Type-Options "nosniff"

    # N'envoie l'URL complete du referrer qu'aux origines identiques ; une origine seule (sans
    # chemin ni jeton) pour un lien externe (I5, signale par la page Sante).
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Desactive les API navigateur non utilisees par le site (aucun appareil photo, micro,
    # geolocalisation ni paiement demande cote client).
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # HSTS : force le navigateur a n'utiliser que HTTPS pour ce domaine.
    # Valeur prudente : 6 mois, sans includeSubDomains (pour ne pas imposer HTTPS a un
    # sous-domaine qui ne serait pas pret) ni preload (irreversible). Une fois valide en
    # production, on peut monter a max-age=31536000 (1 an), puis ajouter includeSubDomains
    # si TOUS les sous-domaines (dont cdn.monrevenu.xyz) sont bien en HTTPS.
    # A ne PAS activer aussi cote Cloudflare (SSL/TLS > Edge Certificates > HSTS) pour eviter
    # un doublon : une seule source suffit.
    Header always set Strict-Transport-Security "max-age=15768000"

    # Masquage signature PHP
    Header unset X-Powered-By
</IfModule>

# Fichiers internes jamais servis (schemas, notes, dependances, outils locaux)
<FilesMatch "(\.(sql|md|lock|sh|log|bak|dist|gz|zip)|^composer\.json|^\.env.*|^\.git.*)$">
    Require all denied
</FilesMatch>
RedirectMatch 404 ^/(dev|\.kilo|\.git|migrations|storage|tools|app_logs)(/|$)
